model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Requirements
ref table ShipToSchedule
ref table Shipments
ref table FGInventory
ref table RunInfo
ref table Holidays
ref table BizCalendar
ref table Parts
ref table Exceptions
ref table BacklogSnapshot
ref table EngineCheck
ref table Language
ref table Translations
